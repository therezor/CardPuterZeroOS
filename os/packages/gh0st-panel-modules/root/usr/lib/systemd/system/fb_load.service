# Set up the panel, show the ghost, then hand it to Gh0st OS.
[Unit]
Description=Boot logo on the CardputerZero LCD
DefaultDependencies=no
After=systemd-udev-trigger.service systemd-udevd.service systemd-modules-load.service
ConditionPathExists=/usr/sbin/fb_load
ConditionVirtualization=!container

# Setup draws after the animation. The timeout bounds any display failure.
[Service]
Type=oneshot
ExecStart=/usr/libexec/gh0st-boot-start
RemainAfterExit=yes
TimeoutStartSec=25

[Install]
WantedBy=sysinit.target
