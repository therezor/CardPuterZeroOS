# The boot logo on the LCD, from M5's st7789v driver repo. It draws once and
# exits: gh0st takes the panel next.
[Unit]
Description=Boot logo on the CardputerZero LCD
DefaultDependencies=no
After=systemd-udev-trigger.service systemd-udevd.service systemd-modules-load.service
ConditionPathExists=/usr/sbin/fb_load
ConditionVirtualization=!container

# A oneshot, so setup draws only after the logo; without --keep-open it
# draws and exits at once. The timeout keeps a hung one from holding boot.
[Service]
Type=oneshot
ExecStart=/usr/sbin/fb_load
RemainAfterExit=yes
TimeoutStartSec=10

[Install]
WantedBy=sysinit.target
