# Device access that raspberrypi-sys-mods gives on Raspberry Pi OS, which
# CPZeroOS doesn't install.

# VideoCore: vcgencmd, the camera ISP and codecs.
KERNEL=="vcio_gencmd|vcio_crypto|vchiq|vcsm-cma", GROUP="video", MODE="0660"
SUBSYSTEM=="vc-sm", GROUP="video", MODE="0660"

# DMA heaps for libcamera; the stock Camera app opens the CMA heap.
SUBSYSTEM=="dma_heap", GROUP="video", MODE="0660"
SUBSYSTEM=="dma_heap", KERNEL=="linux,cma", SYMLINK+="dma_heap/vidbuf_cached", OPTIONS+="link_priority=-50"

SUBSYSTEM=="backlight", ACTION=="add", RUN+="/bin/chgrp video $sys$devpath/brightness", RUN+="/bin/chmod g+w $sys$devpath/brightness"
SUBSYSTEM=="drm", TAG+="systemd"

# Buses and pins for Cap and HAT apps.
SUBSYSTEM=="i2c-dev", GROUP="i2c", MODE="0660"
SUBSYSTEM=="spidev", GROUP="spi", MODE="0660"
SUBSYSTEM=="*gpiomem*", GROUP="gpio", MODE="0660"
SUBSYSTEM=="gpio", GROUP="gpio", MODE="0660"
SUBSYSTEM=="pwm", ACTION!="remove", PROGRAM="/bin/sh -c 'chgrp -R gpio /sys%p && chmod -R g=u /sys%p'"

# CPU governor: schedutil scales with the scheduler's load signal and
# needs no sampling timer. Settings' CPU mode writes 61-gh0st-cpu.rules.
SUBSYSTEM=="cpu", KERNEL=="cpu0", ACTION=="add", ATTR{cpufreq/scaling_governor}="schedutil"

# The SR9900A USB Ethernet chip never suspends on its own: it keeps the hub
# and dwc2 awake at about 8000 IRQ/s and costs about 105 mA.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0fe6", ATTR{idProduct}=="9900", TEST=="power/control", ATTR{power/control}="auto"
