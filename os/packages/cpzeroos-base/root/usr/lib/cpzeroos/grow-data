#!/bin/sh
set -eu
disk=/dev/mmcblk0
stamp=/var/lib/cpzeroos/data-grown
if [ -b "${disk}p3" ]; then
    # p3 is not mounted yet, so the kernel can take its new size while the
    # root partition on the same card stays mounted.
    echo ", +" | sfdisk -q --no-reread --no-tell-kernel -N 3 "$disk"
    partx -u -n 3 "$disk"
    # Let udev finish the change events the write and the resize sent. A
    # change for p3 runs after the ones already queued for it.
    udevadm trigger --settle --action=change "${disk}p3"
    udevadm settle
fi
mkdir -p "${stamp%/*}"
touch "$stamp"
