# First boot: the user data partition (p3, /home) grows to the end of the
# card. systemd-growfs then grows its filesystem as /home mounts.
[Unit]
Description=Grow the user data partition to fill the card
DefaultDependencies=no
After=systemd-remount-fs.service
Before=home.mount local-fs.target
ConditionPathExists=!/var/lib/cpzeroos/data-grown

[Service]
Type=oneshot
ExecStart=/usr/lib/cpzeroos/grow-data

[Install]
WantedBy=local-fs.target
