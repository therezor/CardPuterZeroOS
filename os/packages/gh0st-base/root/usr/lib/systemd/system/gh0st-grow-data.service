# First boot: the user data partition (p3, /home) grows to the end of the
# card. systemd-growfs then grows its filesystem as /home mounts.
[Unit]
Description=Grow the user data partition to fill the card
DefaultDependencies=no
After=systemd-remount-fs.service
# Before local-fs-pre.target, which the fsck units wait for: the new size
# sends udev change events for the card, and a check or mount of /home
# that starts while they run is cut off when the device unit flaps.
Before=local-fs-pre.target home.mount local-fs.target
Wants=local-fs-pre.target
ConditionPathExists=!/var/lib/gh0st/data-grown

[Service]
Type=oneshot
ExecStart=/usr/lib/gh0st/grow-data

[Install]
WantedBy=local-fs.target
