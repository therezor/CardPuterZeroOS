# First boot: the root partition (p2) and its filesystem grow to the end of
# the card, online.
[Unit]
Description=Grow the root partition to fill the card
DefaultDependencies=no
After=systemd-remount-fs.service
# Before local-fs-pre.target, which the fsck units wait for: the new size
# sends udev change events for the card, and a check or mount of the boot
# partition that starts while they run is cut off when the device unit flaps.
Before=local-fs-pre.target local-fs.target
Wants=local-fs-pre.target
ConditionPathExists=!/var/lib/gh0st/root-grown

[Service]
Type=oneshot
ExecStart=/usr/lib/gh0st/grow-root

[Install]
WantedBy=local-fs.target
