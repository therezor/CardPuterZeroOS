#!/bin/sh
set -e
if [ "$1" = configure ]; then
    systemd-sysusers gh0st.conf
    # A fresh install is a new image, which has what every migration adds.
    # An upgrade leaves the new ones for the update engine.
    if [ -z "$2" ]; then
        mkdir -p /var/lib/gh0st/update
        ls /usr/share/gh0st/migrations > /var/lib/gh0st/update/migrations
    fi
    # The private MAC addresses are the image's alone now. Settings no
    # longer writes these, so one left from before would pin its choice
    # with nothing to change it.
    rm -f /etc/NetworkManager/conf.d/90-gh0st-mac.conf \
        /etc/NetworkManager/conf.d/90-gh0st-scan-mac.conf
    # Memory pressure (PSI) tells apps when memory runs short. The kernel
    # keeps it off unless asked; this takes effect at the next boot. The
    # new file is on the card before it replaces the old: an empty one
    # would not boot. A failed edit leaves nothing behind.
    c=/boot/firmware/cmdline.txt
    if [ -s "$c" ] && ! grep -qw 'psi=1' "$c"; then
        if sed '1s/$/ psi=1/' "$c" >"$c.new" && [ -s "$c.new" ] && sync; then
            mv "$c.new" "$c" && sync || rm -f "$c.new"
        else
            rm -f "$c.new"
        fi
    fi
    # The data partition's grow unit is gone. Its card keeps the old
    # layout, and the enable link would point at nothing.
    rm -f /etc/systemd/system/local-fs.target.wants/gh0st-grow-data.service
    # Store apps open their root services' sockets to the users group, as
    # the stock first user is in it. Setup adds it now; this adds it for an
    # account made before. It holds from the next boot.
    user=$(getent passwd 1000 | cut -d: -f1)
    if [ -n "$user" ] && getent group users >/dev/null &&
        ! id -nG "$user" | grep -qw users; then
        usermod -a -G users "$user" || true
    fi
    # The sandbox's bus policy and audio rules hold from now, not from the
    # next boot: an update run by an older engine restarts only the shell
    # (docs/isolation.md). The session bus reads its policy again and the
    # audio services start over, in the running session if there is one.
    if [ -n "$user" ] && [ -S /run/user/1000/bus ]; then
        runuser -u "$user" -- env XDG_RUNTIME_DIR=/run/user/1000 \
            DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus sh -c '
                dbus-send --session --type=method_call --dest=org.freedesktop.DBus \
                    /org/freedesktop/DBus org.freedesktop.DBus.ReloadConfig
                systemctl --user daemon-reload
                systemctl --user try-restart pipewire-pulse.socket wireplumber.service
            ' || true
    fi
fi
