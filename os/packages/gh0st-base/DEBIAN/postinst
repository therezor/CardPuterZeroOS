#!/bin/sh
set -e
if [ "$1" = configure ]; then
    systemd-sysusers gh0st.conf
    # A fresh install is a new image, which has what every migration adds.
    # An upgrade leaves the new ones for the update engine.
    if [ -z "$2" ]; then
        mkdir -p /var/lib/gh0st/update
        ls /usr/share/gh0st/migrations > /var/lib/gh0st/update/migrations
    fi
    # The private MAC addresses are the image's alone now. Settings no
    # longer writes these, so one left from before would pin its choice
    # with nothing to change it.
    rm -f /etc/NetworkManager/conf.d/90-gh0st-mac.conf \
        /etc/NetworkManager/conf.d/90-gh0st-scan-mac.conf
    # The data partition's grow unit is gone. Its card keeps the old
    # layout, and the enable link would point at nothing.
    rm -f /etc/systemd/system/local-fs.target.wants/gh0st-grow-data.service
fi
