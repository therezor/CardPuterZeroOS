# The shell runs as UID 1000 with linger, like the stock launcher it
# replaces. It does not pull in PipeWire: its volume restore at start
# reaches PipeWire through the socket.
[Unit]
Description=Gh0st OS shell
# Exactly one of setup and the shell runs: the shell waits for setup's
# marker to go (docs/setup.md, Power cuts).
ConditionPathExists=!/var/lib/gh0st/setup
ConditionUser=1000
# Never give up restarting: a shell that stays dead leaves a blank device.
StartLimitIntervalSec=0

[Service]
# No desktop session runs xdg-user-dirs-update, and stock apps save to
# ~/Music, ~/Pictures and the rest.
ExecStartPre=-/usr/bin/xdg-user-dirs-update
ExecStart=/usr/bin/gh0st shell
WorkingDirectory=/usr/share/APPLaunch
# The shell gives each app a cgroup of its own, which names it to the
# keyring and the session (docs/isolation.md).
Delegate=yes
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
